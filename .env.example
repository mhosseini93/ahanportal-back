# Copy to .env and adjust
PORT=4010
# Comma-separated list of allowed frontend origins
FRONTEND_URL=http://localhost:3010

# PostgreSQL connection (database and role are created by: npm run db:create)
DATABASE_URL=postgres://ahan_app:password@localhost:5432/ahanportal
# Folder with psql, if not the default C:\Program Files\PostgreSQL\18\bin
# PG_BIN=

# Secret for signing admin tokens (long random string)
JWT_SECRET=change-me

# Admin login. Generate the hash with: npm run admin:hash -- "<password>"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
