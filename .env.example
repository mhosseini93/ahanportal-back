# Copy to .env and adjust
PORT=4010
# Comma-separated list of allowed frontend origins
FRONTEND_URL=http://localhost:3010

# PostgreSQL connection (database and role are created by: npm run db:create)
DATABASE_URL=postgres://ahan_app:password@localhost:5432/ahanportal
# Folder with psql, if not the default C:\Program Files\PostgreSQL\18\bin
# PG_BIN=

# Secret for signing admin tokens (long random string)
JWT_SECRET=change-me

# Admin login. Generate the hash with: npm run admin:hash -- "<password>"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# Uploaded files in MinIO (or any S3-compatible storage). Empty MINIO_ENDPOINT =
# files go to the local uploads/ folder (fine for development)
# MINIO_ENDPOINT=http://localhost:9000
# MINIO_ACCESS_KEY=
# MINIO_SECRET_KEY=
# MINIO_BUCKET=ahanportal
# MINIO_REGION=us-east-1

# Price sync from the old ahanonline database (read-only user is enough).
# Empty = sync off. Every N minutes; a run that finds nothing changed costs one tiny query.
SOURCE_DATABASE_URL=
PRICE_SYNC_INTERVAL_MINUTES=10
# Frontend endpoint that expires cached price pages after a sync, and its shared secret
FRONTEND_REVALIDATE_URL=http://localhost:3010/api/revalidate
REVALIDATE_SECRET=
